# ─────────────────────────────────────────────
# PlantGuard AI — .gitignore
# ─────────────────────────────────────────────

# ── Trained Models ──────────────────────────
# .h5 / .keras files are large; train locally
models/*.h5
models/*.keras
models/*_confusion_matrix.png
models/*_training_history.png
# Keep the models/ directory itself
!models/.gitkeep

# ── Datasets ────────────────────────────────
# Raw/extracted datasets and archives are large; download separately

data/raw/
data/plantdisease/
data/plantdisease.zip
data/plant-doc-dataset/
data/plant-doc-dataset.zip
data/tomatoleaf/
data/tomatoleaf.zip

# ── Uploaded Images ─────────────────────────
# User-uploaded images during app usage
static/uploads/*
!static/uploads/.gitkeep

# ── Python ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Virtual Environments ────────────────────
venv/
env/
.venv/
.env/
ENV/
env.bak/
venv.bak/
crop-ai/

# ── Environment Variables ───────────────────
.env
.env.local
.env.*.local

# ── Jupyter Notebooks ───────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Distribution / Build ────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ── Testing ─────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Logs ────────────────────────────────────
*.log
logs/

# ── OS Files ────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── IDEs & Editors ──────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── Temporary / Debug Files ─────────────────
*.tmp
*.temp
tmp/
temp/
*.json
# Except data config files that belong in the repo
!data/treatments.json
!models/*.json